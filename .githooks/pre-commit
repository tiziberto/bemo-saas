#!/bin/sh
# Pre-commit: evita commitear secretos. Activar una vez con:
#   git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml
  status=$?
  if [ $status -ne 0 ]; then
    echo "✋ gitleaks detectó posibles secretos. Commit abortado." >&2
    exit $status
  fi
else
  echo "⚠️  gitleaks no está instalado — saltando escaneo de secretos." >&2
  echo "    Instalá con: brew install gitleaks" >&2
fi
