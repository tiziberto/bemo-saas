# === Base de datos (dev) ===
POSTGRES_USER=bemo
POSTGRES_PASSWORD=bemo
POSTGRES_DB=bemo
# Contraseña del rol restringido con el que corre la API (sujeto a RLS).
# En producción la rota `apps/api/scripts/set-app-password.js` al desplegar.
BEMO_APP_PASSWORD=bemo_app
DATABASE_URL=postgres://bemo_app:bemo_app@db:5432/bemo
DATABASE_URL_MIGRATE=postgres://bemo:bemo@db:5432/bemo

# === API ===
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Obligatoria en producción (mínimo 32 caracteres): la app NO arranca sin esto.
# Generala con: openssl rand -base64 48
JWT_SECRET=

# === Sólo producción (compose.prod.yaml) ===
# Puerto donde nginx publica el front.
WEB_PORT=80

# === Límites (opcionales, con defaults sanos) ===
# Requests por minuto y por IP: global y sobre /v1/auth (fuerza bruta).
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
# Tamaño máximo del body JSON (el import de pacientes manda el CSV adentro).
BODY_LIMIT=1mb
# Swagger: público en desarrollo; en producción sólo con ENABLE_DOCS=1.
ENABLE_DOCS=
# Adjuntos clínicos: dónde se guardan y cuánto pesa como máximo cada uno.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# === 21st.dev Magic MCP (solo herramienta de dev) ===
# Conseguila en https://21st.dev -> Settings -> API Keys
TWENTYFIRST_API_KEY=
